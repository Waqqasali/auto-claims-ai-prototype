# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
env/

# Credentials. .env.example is committed; .env is not. Streamlit Community
# Cloud keeps the hosted app's key in its secrets settings; a local copy of
# that file must never reach the repository either.
.env
.streamlit/secrets.toml

# Runtime state. The directory is tracked via .gitkeep so a fresh clone has
# somewhere to write; its contents are per-run and must not be committed.
# Everything under runtime/ except the placeholder: uploads, the override log,
# the reuse ledger and the cache of live model answers.
runtime/*
!runtime/.gitkeep

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Personal Claude Code instructions stay local.
CLAUDE.local.md

# Private reference documents for Claude Code. Never committed.
private/
