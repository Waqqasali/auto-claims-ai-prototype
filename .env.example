# Copy this file to .env and fill in your key, or export these directly.
#
# NONE OF THIS IS REQUIRED. The default provider is a deterministic mock that
# runs with no key and no network access, which is the fastest way to see the
# system work. Set these only when you want live vision calls.
#
#   cp .env.example .env

# Leave as "mock" for the scripted provider. Set to "anthropic" for live calls.
VLM_PROVIDER=mock

# Required only when VLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Which model handles the two vision stages. Only read when
# VLM_PROVIDER=anthropic.
ANTHROPIC_MODEL=claude-sonnet-5
